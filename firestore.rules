rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated Firebase user = admin (only one admin account exists)
    function isAdmin() {
      return request.auth != null;
    }

    // ── PRODUCTS ───────────────────────────────────────────────────────────
    // Anyone can read (shop.html shows the catalog publicly)
    // Only admin can create / update / delete
    match /products/{productId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── ORDERS ─────────────────────────────────────────────────────────────
    // Public users may CREATE a new order, with minimal validation:
    //   • status must start as 'messenger_pending' (can't fake confirmed/rejected)
    //   • customerName must be a non-empty string
    //   • items must be a non-empty list
    // Public users may NOT read, update, or delete any order.
    // Admin can do everything.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.status      == 'messenger_pending'  &&
        request.resource.data.customerName is string              &&
        request.resource.data.customerName.size() > 0            &&
        request.resource.data.items        is list                &&
        request.resource.data.items.size() > 0;

      allow read, update, delete: if isAdmin();
    }

    // ── CATCH-ALL ──────────────────────────────────────────────────────────
    // Deny access to every other collection / document not listed above.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
